# Database for order storage + the admin dashboard (/admin).
# Without this, orders still work but nothing is saved — the admin
# dashboard will show "No orders yet." forever.
#
# Get a free Postgres database at https://neon.tech or https://supabase.com,
# then run `npm run db:setup` once to create the orders table.
DATABASE_URL=

# Password for the admin dashboard at /admin. Required for /admin to work.
ADMIN_PASSWORD=

# Order notification emails (optional).
# If RESEND_API_KEY is unset, orders still work — emails are simply skipped.
# Get a key at https://resend.com
RESEND_API_KEY=

# Sender address for order emails. Requires a verified domain in Resend,
# or use the default onboarding@resend.dev sender for testing.
ORDERS_FROM_EMAIL="Hayat+ Orders <onboarding@resend.dev>"
