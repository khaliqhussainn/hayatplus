# Order notification emails (optional).
# If RESEND_API_KEY is unset, orders still work — emails are simply skipped.
# Get a key at https://resend.com
RESEND_API_KEY=

# Sender address for order emails. Requires a verified domain in Resend,
# or use the default onboarding@resend.dev sender for testing.
ORDERS_FROM_EMAIL="Hayat+ Orders <onboarding@resend.dev>"
